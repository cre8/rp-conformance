{
  "name": "rp-conformance",
  "private": true,
  "description": "Functional conformance tests and test harness for EUDI Wallet Relying Parties",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12"
  },
